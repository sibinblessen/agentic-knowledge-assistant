# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is git-ignored, so your project ID never ends up on GitHub.

# Your Google Cloud project ID (not the name) - see: gcloud config get-value project
GOOGLE_CLOUD_PROJECT=your-project-id

# Tells the google-genai SDK to use Google Cloud (Vertex AI / Agent Platform)
# with your gcloud login, instead of a Gemini API key.
GOOGLE_GENAI_USE_VERTEXAI=true

# "global" lets Google route Gemini calls to available capacity.
GOOGLE_CLOUD_LOCATION=global

# Embeddings are served from a regional endpoint. europe-west1 = Belgium.
EMBEDDING_LOCATION=europe-west1

# Leave these empty for now. scripts/check_vertex.py finds working models
# and tells you what to put here.
GEMINI_MODEL=
EMBEDDING_MODEL=

# Local Postgres from docker-compose.yml (Cloud SQL comes in step 4)
DATABASE_URL=postgresql://agent:agent@localhost:5433/knowledge

# Where the agent finds the retrieval API
SEARCH_API_URL=http://localhost:8000

# How many times the agent may rewrite the search query
MAX_REWRITES=2

# Grounding check
JUDGE_MODEL=
MAX_GENERATIONS=2
